{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "*.log",
      "tablero-mockups.html",
      "seed-data.js",
      "backend/**",
      "docs/**",
      "**/serviceAccountKey*.json"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/Nexo.html"
      }
    ]
  }
}

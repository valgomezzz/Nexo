{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "backend/**", "**/.*", "*.md"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/", "destination": "/Nexo.html" }
    ]
  }
}

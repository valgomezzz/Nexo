rules_version = '2';
// Toda la lectura/escritura pasa por la API en Java (Admin SDK, que ignora estas reglas).
// Así el navegador no puede saltarse las validaciones ni ver reportes ajenos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
